{
  "name": "alelm-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-next-redirect-headers.mjs && node scripts/copy-mediapipe-wasm.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/*.test.mjs",
    "budget": "node scripts/check-performance-budget.mjs",
    "audit:migration": "node --env-file-if-exists=.env.local --max-old-space-size=8192 scripts/audit-wp-parity.mjs",
    "policy:check": "node scripts/policy-check.mjs",
    "test": "npm run lint && npm run typecheck && npm run build:gate && NEXT_DIST_DIR=.next-gate npm run test:unit && NEXT_DIST_DIR=.next-gate npm run budget",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:gate": "NEXT_DIST_DIR=.next-gate DATABASE_URL= next build",
    "db:push": "node --env-file=.env.local scripts/guard-db-push.mjs && node --env-file=.env.local node_modules/.bin/drizzle-kit push",
    "db:push:prod": "node scripts/db-push-prod-instructions.mjs",
    "db:seed": "node --env-file=.env.local scripts/db-seed.mjs",
    "migrate:wp": "node --env-file=.env.local scripts/wp-migrate.mjs",
    "media:migrate": "node --env-file=.env.local scripts/wp-media-migrate.mjs",
    "test:integration": "node tests/migration-adoption.integration.mjs && node tests/workflow.integration.mjs && node tests/permission-matrix.integration.mjs && node tests/member-account.integration.mjs && node tests/staff-recovery.integration.mjs && node tests/admin-saving.integration.mjs && node tests/profiles-audience.integration.mjs && node tests/public-readings.integration.mjs && node tests/public-interactions.integration.mjs && node tests/dashboard-performance.integration.mjs && node tests/retention.integration.mjs && node tests/public-cache.integration.mjs && node tests/infographics-archive.integration.mjs && node tests/canonical-redirects.integration.mjs && node tests/image-delivery.integration.mjs && node tests/public-search.integration.mjs && node tests/editor-search.integration.mjs && node tests/indexing-runtime.integration.mjs && node tests/origin-runtime.integration.mjs && node tests/jak-reports.integration.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-db.mjs",
    "scheduler:tick": "node scripts/scheduler-tick.mjs",
    "test:restore": "node scripts/test-restore.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@aws-sdk/client-s3": "^3.1108.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/extension-text-align": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.522.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "parse5": "8.0.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.3",
    "socket.io-client": "4.8.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.0",
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "pg": "^8.23.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "wrangler": "4.120.0"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
